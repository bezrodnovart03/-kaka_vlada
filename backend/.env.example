# Сгенерировать: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string-of-50-chars
DEBUG=True
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TIME_ZONE=Europe/Moscow

# SQLite по умолчанию; для PostgreSQL: DB_ENGINE=django.db.backends.postgresql + DB_HOST/DB_PORT/DB_USER/DB_PASSWORD
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Флаг Secure у cookie с refresh-токеном; если не задан — включён при DEBUG=False
# JWT_REFRESH_COOKIE_SECURE=false

# Администратор системы: создаётся/обновляется после migrate
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=

# Telegram-напоминания. Токен — у @BotFather; id чата — добавьте бота в чат и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates (у групп id отрицательный, -100...).
# Без этих значений панель и API работают, но сообщения не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# За сколько дней до срока напоминать (минимум по кейсу — 3)
REMINDER_DAYS_BEFORE=3
# Как часто run_reminders проверяет сроки, секунд
REMINDER_CHECK_INTERVAL_SECONDS=60
# Кнопка «Оплачено» прямо в сообщении бота
TELEGRAM_PAY_BUTTON=true
# Ссылка на панель в тексте напоминания (необязательно)
PANEL_URL=http://localhost:5173

# ── Дополнительные каналы напоминаний (всё необязательно) ──

# Email через SMTP. Включается, если задан REMINDER_EMAIL_TO или REMINDER_EMAIL_TO_USERS=true.
# Для Яндекса: smtp.yandex.ru, 465, EMAIL_USE_SSL=true, EMAIL_USE_TLS=false, пароль приложения.
# Локально без SMTP: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   → EMAIL_HOST=localhost, EMAIL_PORT=1025, EMAIL_USE_TLS=false; письма на http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=Invoice Keeper <noreply@localhost>
# Получатели (JSON-список); пусто — email выключен
REMINDER_EMAIL_TO=[]
# Также слать на email активных пользователей
REMINDER_EMAIL_TO_USERS=false

# Webhook: POST JSON на адрес; подпись HMAC-SHA256 в X-Invoice-Keeper-Signature
WEBHOOK_URL=
WEBHOOK_SECRET=

# Другие каналы через Apprise (JSON-список URL): Discord, Slack, ntfy, Matrix, Teams...
# Формат URL: https://github.com/caronc/apprise/wiki  Пример: ["ntfy://invoice-keeper"]
NOTIFY_URLS=[]

# ── Чеки к оплатам и логи ──
MEDIA_ROOT=media
ATTACHMENT_MAX_MB=10
# Файл логов с ротацией (5 МБ × 5); пусто — только консоль
LOG_FILE=
