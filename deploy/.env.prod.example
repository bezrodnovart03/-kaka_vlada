# Параметры Compose на сервере: cp deploy/.env.prod.example .env (рядом с compose.yaml).
# Настройки приложения (SECRET_KEY, ADMIN_*, TELEGRAM_*) — по-прежнему в backend/.env.

# Домен панели. Своего нет — подойдёт <IP-через-дефисы>.sslip.io, например 203-0-113-7.sslip.io:
# он сам указывает на этот IP, и Let's Encrypt выдаёт для него сертификат.
DOMAIN=203-0-113-7.sslip.io

# Те же значения, что DOMAIN (Compose не подставляет переменные внутрь JSON-списков из .env).
ALLOWED_HOSTS=["203-0-113-7.sslip.io","localhost","127.0.0.1","backend"]
CSRF_TRUSTED_ORIGINS=["https://203-0-113-7.sslip.io"]
PANEL_URL=https://203-0-113-7.sslip.io
JWT_REFRESH_COOKIE_SECURE=true

# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# 1 — демо-данные при первом старте (только при пустой базе)
SEED_DEMO=0
# Для сервера с 1 ГБ памяти хватит одного процесса
GUNICORN_WORKERS=2
