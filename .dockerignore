# Для сборки deploy/render/Dockerfile (контекст — корень репозитория).
# compose.yaml собирает из backend/ и frontend/ — там свои .dockerignore.
**/.env
**/.DS_Store
.git/
backend/.venv/
backend/db.sqlite3*
backend/media/
backend/staticfiles/
backend/.test-media/
backend/logs/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.schemathesis/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
